{
  "name": "gdicristofaro.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build-resume": "jobapp-build . --override-input-file src/model/resume.yaml --override-resume-html-output src/model/resume.html --override-resume-pdf-output public/resume.pdf --generate-resume-txt=false",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "predeploy": "npm run build-resume && npm run build && touch dist/.nojekyll",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@icons-pack/react-simple-icons": "^13.13.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.17.0"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.12.1",
    "@eslint/js": "^9.0.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^25.9.1",
    "@types/react": "^19.2.16",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "axe-core": "^4.12.1",
    "eslint": "^9.0.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.6.0",
    "jobappbuild": "github:gdicristofaro/JobAppBuild",
    "puppeteer": "^25.1.0",
    "tailwindcss": "^4.3.0",
    "tsx": "^4.22.4",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vitest": "^4.1.9"
  },
  "allowScripts": {
    "esbuild": true,
    "jobappbuild": true,
    "puppeteer": true,
    "github:gdicristofaro/JobAppBuild#b621632522c45a531cca5fdbe7ad8175c7695be8": true
  }
}
