{
  "name": "gdicristofaro.github.io",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "build-resume": "jobapp-build . --override-input-file src/model/resume.yaml --override-resume-html-output src/model/resume.html --override-resume-pdf-output public/resume.pdf --generate-resume-txt=false",
    "lint": "eslint",
    "lint-fix": "eslint --fix",
    "predeploy": "npm run build-resume && npm run build && touch dist/.nojekyll",
    "deploy": "gh-pages -d dist -t"
  },
  "dependencies": {
    "@heroicons/react": "^2.2.0",
    "@icons-pack/react-simple-icons": "^13.15.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@axe-core/puppeteer": "^4.13.0",
    "@eslint/js": "^9.39.5",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "gh-pages": "^6.3.0",
    "globals": "^17.12.0",
    "jobappbuild": "github:gdicristofaro/JobAppBuild",
    "puppeteer": "^25.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "esbuild": true,
    "jobappbuild": true,
    "puppeteer": true,
    "github:gdicristofaro/JobAppBuild#b621632522c45a531cca5fdbe7ad8175c7695be8": true
  }
}
