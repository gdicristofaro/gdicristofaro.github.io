{{!--
  Standalone letterhead page: the resume header, a section heading with the
  given title, and pre-rendered (marked-parsed markdown) HTML content.
--}}
{{#*inline "phoneIcon"}}<svg class="highlight-color icon inline-block align-text-bottom mr-1/2" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M2.25 6.75c0 8.284 6.716 15 15 15h2.25a2.25 2.25 0 0 0 2.25-2.25v-1.372c0-.516-.351-.966-.852-1.091l-4.423-1.106c-.44-.11-.902.055-1.173.417l-.97 1.293c-.282.376-.769.542-1.21.38a12.035 12.035 0 0 1-7.143-7.143c-.162-.441.004-.928.38-1.21l1.293-.97c.363-.271.527-.734.417-1.173L6.963 3.102a1.125 1.125 0 0 0-1.091-.852H4.5A2.25 2.25 0 0 0 2.25 4.5v2.25Z"></path></svg>{{/inline}}
{{#*inline "emailIcon"}}<svg class="highlight-color icon inline-block align-text-bottom mr-1/2" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M21.75 6.75v10.5a2.25 2.25 0 0 1-2.25 2.25h-15a2.25 2.25 0 0 1-2.25-2.25V6.75m19.5 0A2.25 2.25 0 0 0 19.5 4.5h-15a2.25 2.25 0 0 0-2.25 2.25m19.5 0v.243a2.25 2.25 0 0 1-1.07 1.916l-7.5 4.615a2.25 2.25 0 0 1-2.36 0L3.32 8.91a2.25 2.25 0 0 1-1.07-1.916V6.75"></path></svg>{{/inline}}
{{#*inline "linkIcon"}}<svg class="highlight-color icon inline-block align-baseline mr-1/2" fill="none" stroke-width="1.5" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M13.19 8.688a4.5 4.5 0 0 1 1.242 7.244l-4.5 4.5a4.5 4.5 0 0 1-6.364-6.364l1.757-1.757m13.35-.622 1.757-1.757a4.5 4.5 0 0 0-6.364-6.364l-4.5 4.5a4.5 4.5 0 0 0 1.242 7.244"></path></svg>{{/inline}}
<div class="resume-container">
  <header class="mb-4 break-inside-avoid-page">
    <h1 class="text-3xl font-bold text-gray-800 dark:text-gray-100 mb-1 uppercase">Greg DiCristofaro</h1>
    <p class="font-semibold text-base highlight-color mb-1">Software Engineer</p>
    <div class="flex flex-wrap gap-x-3 gap-y-2 text-sm text-gray-600 dark:text-gray-300">
      <div><a href="tel:+2155104508">{{> phoneIcon}}<span>(215) 510-4508</span></a></div>
      <div><a href="mailto:gregdicristofaro@gmail.com">{{> emailIcon}}<span>gregdicristofaro@gmail.com</span></a></div>
      <div><a href="https://www.gdicristofaro.com">{{> linkIcon}}<span>gdicristofaro.com</span></a></div>
      <div><a href="https://www.github.com/gdicristofaro">{{> linkIcon}}<span>github.com/gdicristofaro</span></a></div>
    </div>
  </header>
  <h2 class="text-xl font-semibold uppercase text-gray-800 dark:text-gray-100 pb-1 border-b-2 border-gray-800 dark:border-gray-100 mb-5">{{title}}</h2>
  <div class="content-section text-gray-600 text-base">{{{contentHtml}}}</div>
</div>
